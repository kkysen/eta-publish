# Build output: regenerated from the source Google Doc on every run.
/out/

__pycache__/
*.py[cod]
.venv/
*.egg-info/

# OAuth client secret and token; never commit these.
client_secret*.json
token.json

# Scratch output directories from ad-hoc runs.
/out*/

# `site/` is the published site, written by `eta-publish`, and
# `tests/fixture/` is the same shape built from a hand-written document.
# Only the text is committed: the images are 18 MB and the PDF 19 MB, and
# every re-fetch would add another copy to history forever. Both are
# rebuilt by CI before deploying, so nothing here is needed to publish.
/site/**/images/
/site/**/report.pdf
/site/**/template.typ
/site/index.html
/tests/fixture/**/images/
/tests/fixture/**/report.pdf
/tests/fixture/**/template.typ
/tests/fixture/index.html
