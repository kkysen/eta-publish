# Build output: regenerated from the source Google Doc on every run.
/out/

__pycache__/
*.py[cod]
.venv/
*.egg-info/

# OAuth client secret and token; never commit these.
client_secret*.json
token.json

# Scratch output directories from ad-hoc runs.
/out*/

# `tests/real/` is written by `eta-publish <doc-url> -o tests/real`, but
# only its text outputs are committed: the images are 18 MB and the PDF
# 19 MB, and every re-fetch would add another copy to history forever.
# `tests/fixture/` is the same shape, built from a hand-written document.
/tests/*/**/images/
/tests/*/**/report.pdf
/tests/*/**/template.typ
/tests/*/index.html
